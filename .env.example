NODE_ENV=development
PORT=3000

# Paste your Aiven PostgreSQL connection string here.
# Example:
# DATABASE_URL=postgres://avnadmin:password@your-host.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=

# Optional. Render and Aiven usually need SSL enabled.
PGSSL=true

# Optional login seed accounts. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123
